# Copy to .env.local for development; set the same variables in Netlify for production.

# Supabase dashboard -> Project Settings -> API Keys. Only used on the server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated subdomains that serve short links.
# Locally, Chrome resolves *.localhost, so use e.g. events.localhost:3000 to test redirects.
SHORT_LINK_HOSTS=events.rflwealth.ca,dinner-seminars.rflwealth.ca

# Where a short-link subdomain sends visitors for an empty or unknown code.
SHORT_LINK_FALLBACK_URL=https://rflwealth.ca
